<% content_for :title, "Choose a password" %>
<h1><%= @user.activated? ? "Reset your password" : "Welcome to RubyAPM" %></h1>
<p class="muted">Choose a password for <strong><%= @user.email %></strong> (at least <%= User::MIN_PASSWORD %> characters).</p>
<% if @user.errors.any? %><div class="callout bad"><%= @user.errors.full_messages.to_sentence %></div><% end %>
<%= form_with url: password_setup_path(params[:token]), method: :patch, class: "auth-form" do |f| %>
  <input type="email" name="email" value="<%= @user.email %>" autocomplete="username" hidden>
  <%= f.label :password, "New password" %>
  <%= f.password_field :password, required: true, autofocus: true, minlength: User::MIN_PASSWORD, maxlength: 72, autocomplete: "new-password" %>
  <%= f.label :password_confirmation, "Repeat it" %>
  <%= f.password_field :password_confirmation, required: true, minlength: User::MIN_PASSWORD, maxlength: 72, autocomplete: "new-password" %>
  <%= f.submit "Set password and sign in" %>
<% end %>
