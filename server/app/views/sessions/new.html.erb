<% content_for :title, "Sign in" %>
<h1>Sign in</h1>
<% if User.none? %>
  <div class="callout info">
    <strong>No users yet.</strong> Create the first admin on the server, then open the setup link it prints:
    <pre>bin/rails rubyapm:create_user EMAIL=you@example.com ROLE=admin</pre>
  </div>
<% end %>
<%= form_with url: login_path, class: "auth-form" do |f| %>
  <%= f.label :email %>
  <%= f.email_field :email, value: params[:email], required: true, autofocus: true, autocomplete: "username" %>
  <%= f.label :password %>
  <%= f.password_field :password, required: true, autocomplete: "current-password" %>
  <%= f.submit "Sign in" %>
<% end %>
<p class="muted auth-foot">Forgot your password? Ask an admin for a new setup link.</p>
