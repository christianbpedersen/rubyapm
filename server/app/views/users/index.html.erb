<% content_for :title, "Users" %>
<div class="page-head">
  <div><h1>Users</h1><div class="sub">Admins manage users; members see every app.</div></div>
  <%= link_to "Add user", new_user_path, class: "button" %>
</div>
<div class="panel">
  <div class="table-wrap">
    <table data-controller="table-sort">
      <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last sign-in</th><th class="num">Browsers</th><th></th></tr></thead>
      <tbody>
        <% @users.each do |u| %>
          <tr>
            <td><%= link_to u.name.presence || "–", edit_user_path(u) %><% if u == current_user %> <span class="muted">(you)</span><% end %></td>
            <td><%= u.email %></td>
            <td><span class="badge <%= u.admin? ? 'type-web' : '' %>"><%= u.role %></span></td>
            <td><%= u.activated? ? "Active" : tag.span("Invited", class: "badge warn") %></td>
            <td data-sort-value="<%= u.last_sign_in_at.to_i %>"><%= u.last_sign_in_at ? time_ago(u.last_sign_in_at) : "never" %></td>
            <td class="num"><%= @session_counts[u.id].to_i %></td>
            <td class="row-actions">
              <%= link_to "Edit", edit_user_path(u) %>
              <%= button_to (u.activated? ? "Reset link" : "Setup link"), setup_link_user_path(u), class: "link-button" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
