<% content_for :title, "External APIs" %>
<% content_for :crumb, "External APIs" %>
<div class="page-head"><div><h1>External APIs</h1><div class="sub">Outbound HTTP calls made while serving requests and jobs</div></div></div>
<div class="tiles">
  <div class="tile"><div class="label">Time in external calls</div><div class="value"><%= fmt_ms(@summary[:layers]["external"]) %></div><div class="hint">per transaction</div></div>
  <div class="tile"><div class="label">Share of all time</div><div class="value"><%= fmt_pct(@summary[:avg].positive? ? @summary[:layers]["external"].to_f / @summary[:avg] : 0) %></div></div>
  <div class="tile"><div class="label">Services</div><div class="value"><%= @hosts.size %></div></div>
  <div class="tile"><div class="label">Calls</div><div class="value"><%= fmt_rpm(@hosts.sum { |h| h[:rpm] }) %></div></div>
</div>
<% palette = %w[#3b82f6 #f59e0b #ef4444 #14b8a6 #6366f1 #a855f7 #84cc16 #ec4899] %>
<div class="grid two">
  <div class="panel"><div class="panel-head"><h2>Time spent per service</h2><span class="hint">ms of wall time per minute</span></div>
    <%= chart(type: "area", stacked: true, series: @time_series.each_with_index.map { |(h, d), i| { label: h, data: d, color: palette[i % 8] } }) %></div>
  <div class="panel"><div class="panel-head"><h2>Response time</h2><span class="hint">avg per call</span></div>
    <%= chart(type: "line", series: @avg_series.each_with_index.map { |(n, d), i| { label: n.delete_prefix("External/"), data: d, color: palette[i % 8] } }) %></div>
  <div class="panel"><div class="panel-head"><h2>Calls per minute</h2></div>
    <%= chart(type: "line", unit: "rpm", series: @call_series.each_with_index.map { |(h, d), i| { label: h, data: d, color: palette[i % 8] } }) %></div>
</div>
<div class="panel">
  <table data-controller="table-sort">
    <thead><tr><th>Service</th><th class="num">Calls</th><th class="num">Avg</th><th class="num">Max</th><th class="num">Total time</th><th>Share of all time</th><th>Endpoints</th></tr></thead>
    <tbody>
      <% @hosts.each do |h| %>
        <tr>
          <td><%= link_to h[:host], app_external_host_path(current_app, h[:host], **range_params), class: "mono" %></td>
          <td class="num"><%= fmt_rpm(h[:rpm]) %></td><td class="num"><%= fmt_ms(h[:avg]) %></td><td class="num"><%= fmt_ms(h[:max]) %></td>
          <td class="num"><%= fmt_ms(h[:total]) %></td><td><%= share_bar(h[:share], "#3b82f6") %></td>
          <td class="muted"><%= h[:segments].map { |s| s[:name].split("/").last }.join(", ") %></td>
        </tr>
      <% end %>
      <% if @hosts.empty? %><tr><td colspan="7" class="empty">No outbound HTTP calls recorded.</td></tr><% end %>
    </tbody>
  </table>
</div>
