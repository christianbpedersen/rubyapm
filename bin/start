#!/usr/bin/env bash
# Starts the RubyAPM server (4400), the fake third-party APIs (4501) and the
# Shopwell sample app (4500, 2 Puma workers) in the background.
# Logs and pids go to ./log. Stop everything with bin/stop.
set -euo pipefail
cd "$(dirname "$0")/.."
ROOT=$PWD
export PATH="$HOME/.rbenv/shims:$PATH"
mkdir -p log

start() { # name port dir command...
  local name=$1 port=$2 dir=$3; shift 3
  if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "$name already running on port $port"; return
  fi
  # setsid: own session and process group, so the service outlives the shell
  # (or tool) that started it and never holds its terminal.
  # exec: no shell stays behind waiting on the service (and holding our stdout).
  (cd "$dir" && exec nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' -- "$@") </dev/null >"$ROOT/log/$name.log" 2>&1 &
  echo $! >"$ROOT/log/$name.pid"
  echo "started $name (pid $(cat log/$name.pid)), log/$name.log"
}

start server 4400 server bin/rails server -p 4400 -b 127.0.0.1 -P "$ROOT/tmp-server.pid"
start fake_services 4501 fake_services puma -t 16:32 -b tcp://127.0.0.1:4501 -b "tcp://[::1]:4501" --pidfile "$ROOT/tmp-fake_services.pid" config.ru
start sample 4500 sample_app env WEB_CONCURRENCY=2 RAILS_MAX_THREADS=5 bin/rails server -p 4500 -b 127.0.0.1 -P "$ROOT/tmp-sample.pid"

for url in http://127.0.0.1:4400/up http://127.0.0.1:4501/ http://127.0.0.1:4500/up; do
  for _ in $(seq 1 60); do curl -sf -o /dev/null "$url" && break; sleep 0.5; done
  curl -sf -o /dev/null "$url" && echo "up: $url" || echo "NOT UP: $url (see log/)"
done
echo "Dashboard: http://localhost:4400   Sample app: http://localhost:4500"
echo "Generate load: bin/simulate   (or bin/start-simulation to run it in the background)"
